  "firewall_probe": {
    "threat_model": "silent_parser_network_dependency",
    "canary": {
      "host": "1.1.1.1",
      "reason_bare_ip_not_dns_name": "dns_failure_alone_cannot_masquerade_as_egress_block"
    },
    "probes": [
      {
        "name": "tcp_connect",
        "call": "socket.create_connection((\"1.1.1.1\", 443), timeout=5.0)",
        "timeout_seconds": 5.0,
        "expected_failure_exception_classes": ["ConnectionRefusedError", "TimeoutError", "OSError"],
        "expected_failure_errno_values": ["ECONNREFUSED", "ETIMEDOUT", "ENETUNREACH", "EHOSTUNREACH", "EACCES"],
        "any_successful_connect_means": "probe_fail_network_not_blocked"
      },
      {
        "name": "https_get",
        "call": "urllib.request.urlopen(\"https://1.1.1.1/\", timeout=5.0)",
        "timeout_seconds": 5.0,
        "expected_failure_exception_classes": ["URLError", "TimeoutError", "OSError"],
        "any_http_response_means": "probe_fail_network_not_blocked"
      }
    ],
    "total_probe_wall_clock_budget_seconds": 15,
    "network_egress_blocked_true_iff": "both_probes_raise_from_expected_failure_list",
    "otherwise": "network_egress_blocked_false_and_defect",
    "defect_reason_when_false": "network_egress_not_blocked",
    "dns_only_failure_admissible": false,
    "positive_control_before_smoke": {
      "process_context": "separate_process_not_under_firewall_rule",
      "expected_both_probes_succeed": true,
      "if_fail_smoke_does_not_proceed": true,
      "recorded_fields": [
        "positive_control_started_at",
        "positive_control_finished_at",
        "positive_control_pass"
      ]
    },
    "positive_control_after_smoke": {
      "process_context": "separate_process_not_under_firewall_rule",
      "expected_both_probes_succeed": true,
      "if_fail_smoke_is_inconclusive": true,
      "recorded_fields": [
        "post_smoke_positive_control_pass"
      ]
    },
    "windows_firewall_rule": {
      "display_name": "AksharaMD-Smoke-Egress-Block",
      "direction": "Outbound",
      "action": "Block",
      "profile": "Any",
      "enabled": true,
      "match_by": "parser_worker_executable_path",
      "created_via": "New-NetFirewallRule PowerShell cmdlet",
      "verified_via": "Get-NetFirewallRule",
      "cleaned_up_at_smoke_end": true,
      "cleanup_failure_is_harness_defect": true,
      "recorded_fields": [
        "firewall_rule_verified_at",
        "firewall_rule_enabled"
      ]
    }
  },
  "pass_fail_criteria": {
    "execution_count": {
      "required_attempts": 12,
      "required_valid_execution_records": 12,
      "missing_or_unparseable_record_is": "harness_fail"
    },
    "environment_and_contract_hash": {
      "required_matches": [
        "python_version_matches_pinned",
        "platform_string_matches_pinned_prefix",
        "parser_package_version_matches_pinned",
        "parser_execution_contract_version_equals_v1",
        "parser_execution_contract_config_sha256_matches",
        "smoke_spec_config_sha256_matches",
        "normalization_version_equals_2"
      ]
    },
    "network_enforcement": {
      "required": [
        "positive_control_pass_true_pre_smoke",
        "post_smoke_positive_control_pass_true",
        "firewall_rule_verified_at_populated",
        "firewall_rule_enabled_true_at_start",
        "every_record_network_egress_blocked_true_or_defect_with_coded_reason"
      ]
    },
    "schema_completeness": {
      "required_fields_source": "benchmarks/eval_v1/config/parser_execution_contract_v1.json::execution_record_schema.required_fields",
      "nullability_source": "benchmarks/eval_v1/config/parser_execution_contract_v1.json::execution_record_schema.nullable_fields",
      "missing_required_or_unexpectedly_null_is": "harness_fail"
    },
    "downstream_flow_for_executed_invocations": {
      "required": [
        "normalized_output_md_exists",
        "analysis_record_json_exists",
        "analysis_record_links_to_execution_record_by_pair_id",
        "reviewer_artifact_constructed_with_all_fields_populated",
        "blinded_parser_hash_equals_sha256_parser_id_first_16_hex",
        "no_parser_identity_leakage_in_reviewer_surface",
        "no_labels_emitted_q1_q2_q3_remain_unanswered"
      ]
    },
    "parser_defect_criterion": {
      "parser_level_defect_compatible_with_pass": true,
      "defect_record_must_still_satisfy": [
        "execution_count",
        "environment_and_contract_hash",
        "network_enforcement",
        "schema_completeness"
      ]
    },
    "outcomes": {
      "pass": "all_of_5_1_through_5_5_satisfied",
      "fail": "any_criterion_violated_or_any_harness_level_defect_from_section_7_2",
      "inconclusive": "positive_control_pass_false_or_post_smoke_positive_control_pass_false"
    }
  },
